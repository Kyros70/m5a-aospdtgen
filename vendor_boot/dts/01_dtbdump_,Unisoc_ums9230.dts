	sprd-pcm-iis {
		compatible = "unisoc,sharkl5-pcm-platform";
		#sound-dai-cells = <0x00>;
		dmas = <0xbb 0x05 0xbb 0x06>;
		dma-names = "iis0_tx", "iis0_rx";
		sprd,dma-2stage-usecase = <0x02>;
		sprd,node-count-2stage-level-1 = <0x01>;
		sprd,syscon-pmu-apb = <0x0d>;
		sprd,dma-2stage-level-1-int-source = <0x01>;
		phandle = <0xbc>;
	};

	sound@1 {
		compatible = "unisoc,i2s-null-codec";
		status = "disabled";
		sprd-audio-card,name = "all-i2s";
		phandle = <0x17e>;

		sprd-audio-card,dai-link@0 {

			plat {
				sound-dai = <0xbc>;
			};

			cpu {
				sound-dai = <0xbd>;
			};

			codec {
				sound-dai = <0x00 0x00>;
			};
		};
	};

	display-subsystem {
		compatible = "sprd,display-subsystem";
		ports = <0xbe>;
		gsp = <0xbf>;
	};

	audcp-iram@65009400 {
		reg = <0x00 0x65009400 0x00 0x1000>;
		phandle = <0xa9>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x17f>;

		ddrbist-mem@0x80000000 {
			reg = <0x00 0x80000000 0x00 0x1000>;
			phandle = <0x180>;
		};

		sysdumpinfo-mem@80001000 {
			reg = <0x00 0x80001000 0x00 0x1000>;
			phandle = <0x181>;
		};

		sp-ddr-mem@88000000 {
			reg = <0x00 0x88000000 0x00 0x300000>;
			phandle = <0x182>;
		};

		audiodsp-mem@89000000 {
			reg = <0x00 0x89000000 0x00 0x600000>;
			phandle = <0xab>;
		};

		cp-modem@89600000 {
			reg = <0x00 0x89600000 0x00 0x4900000>;
			phandle = <0x183>;
		};

		sipc-mem@8e000000 {
			reg = <0x00 0x8e000000 0x00 0x900000>;
			phandle = <0x184>;
		};

		iq-mem@90000000 {
			compatible = "sprd,iq-mem";
			reg = <0x00 0x90000000 0x00 0x4000000>;
			phandle = <0xd4>;
		};

		audio-mem@94100000 {
			reg = <0x00 0x94100000 0x00 0x300000>;
			phandle = <0xaa>;
		};

		uboot_log-mem {
			reg = <0x00 0x9de80000 0x00 0x80000>;
			phandle = <0x185>;
		};

		sysdump-uboot@9f000000 {
			reg = <0x00 0x9f000000 0x00 0x1000000>;
			phandle = <0x186>;
		};

		sml-mem@b0000000 {
			reg = <0x00 0xb0000000 0x00 0x40000>;
			phandle = <0x187>;
		};

		tos-mem@b0040000 {
			reg = <0x00 0xb0040000 0x00 0x5fc0000>;
			phandle = <0x188>;
		};

		sh-mem@b6000000 {
			reg = <0x00 0xb6000000 0x00 0x100000>;
			phandle = <0xc0>;
		};

		cma_share@f00000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xf0000000 0x00 0x3000000>;
			reusable;
			linux,cma-default;
			phandle = <0x189>;
		};

		rebootescrow@0xfff70000 {
			no-map;
			reg = <0x00 0xfff70000 0x00 0x10000>;
		};

		ramoops@fff80000 {
			compatible = "ramoops";
			reg = <0x00 0xfff80000 0x00 0x40000>;
			record-size = <0x8000>;
			console-size = <0x8000>;
			pmsg-size = <0x8000>;
			phandle = <0x18a>;
		};
	};

