	idle-states {
		entry-method = "arm,psci";

		lit_core-pd {
			compatible = "arm,idle-state";
			entry-latency-us = <0x3e8>;
			exit-latency-us = <0x1f4>;
			min-residency-us = <0x9c4>;
			local-timer-stop;
			arm,psci-suspend-param = <0x10000>;
			phandle = <0xac>;
		};

		big_core-pd {
			compatible = "arm,idle-state";
			entry-latency-us = <0xfa0>;
			exit-latency-us = <0xfa0>;
			min-residency-us = <0x2710>;
			local-timer-stop;
			arm,psci-suspend-param = <0x10000>;
			phandle = <0xae>;
		};
	};

	debuglog {
		compatible = "sprd,debuglog";
		sprd,pdbg-irq-domain-gic = "GICv3";
		sprd,pdbg-irq-domain-gpio = "sprd-gpio";
		sprd,pdbg-irq-domain-ana = "spi4.0";
		sprd,pdbg-irq-domain-ana-eic = "64200000.spi:pmic@0:gpio@280";
		sprd,pdbg-irq-domain-ap-eic-sync = "641000c0.gpio";
		phandle = <0x17a>;
	};

	debugstat {
		compatible = "sprd,debugstat";
		soc_slp_cnt_reg = <0x0d 0xe60 0xff>;
		phandle = <0x17b>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
		arm,no-tick-in-suspend;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04>;
	};

	sprd-gsp {
		compatible = "sprd,gsp-r8p0-qogirl6";
		core-cnt = <0x01>;
		io-cnt = <0x07>;
		cores = <0xb0>;
		phandle = <0xbf>;
	};

	cpufreq-cluster0 {
		sprd,temp-threshold = <0x41>;
		nvmem-cells = <0xb1>;
		nvmem-cell-names = "dvfs_bin";
		sprd,multi-version;
		sprd,cpufreq-boost;
		sprd,pmic-type = <0x00>;
		sprd,cluster-cpumask = <0x3f>;
		sprd,transition-delay = <0x1f4>;
		phandle = <0xad>;
	};

	cpufreq-cluster1 {
		sprd,temp-threshold = <0x41>;
		nvmem-cells = <0xb2>;
