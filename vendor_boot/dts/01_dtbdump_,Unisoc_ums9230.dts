/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	cpuinfo_hardware = "Unisoc ums9230";
	soc-module = "UMS9230";
	soc-manufacturer = "Spreadtrum";
	model = "Spreadtrum UMS9230 1H10 SoC";
	compatible = "sprd,ums9230";
	sprd,sc-id = "ums9230 1000 1000";

	qos {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		ranges;

		qos@0 {
			reg = <0x00>;
			arqos = [06];
			awqos = [06];
			arqos-threshold = [0f];
			awqos-threshold = [0f];
			phandle = <0xd5>;
		};

		qos@1 {
			reg = <0x01>;
			awqos-high = [0a];
			awqos-low = [0a];
			arqos-high = [0d];
			arqos-low = [0c];
			arqos-threshold = [0c];
			awqos-threshold = [0f];
			phandle = <0x27>;
		};

		qos@2 {
			reg = <0x02>;
			awqos = [01];
			arqos-high = [07];
			arqos-low = [01];
			phandle = <0xd6>;
		};

		mm {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qos@0 {
				reg = <0x00>;
				arqos = [0a];
				awqos-high = [0d];
				awqos-low = [0c];
				phandle = <0x1d>;
			};

			qos@1 {
				reg = <0x01>;
				awqos-high = [07];
				awqos-low = [06];
				arqos-high = [07];
				arqos-low = [06];
				phandle = <0x1a>;
			};

			qos@2 {
				reg = <0x02>;
				awrqos = [01];
				phandle = <0x1f>;
			};

			qos@3 {
				reg = <0x03>;
				arqos = [01];
				awqos = [01];
				phandle = <0xd7>;
			};

			qos@4 {
				reg = <0x04>;
				arqos-high = [07];
				arqos-low = [01];
				awqos = [01];
				phandle = <0xd8>;
			};

			qos@5 {
				reg = <0x05>;
				arqos-threshold = [06];
				awqos-threshold = [06];
				phandle = <0x11>;
			};
		};

		ap {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qos@0 {
				reg = <0x00>;
				arqos-ce = [05];
				awqos-ce = [05];
				arqos-dma = [05];
				awqos-dma = [05];
				phandle = <0xd9>;
			};

			qos@1 {
				reg = <0x01>;
				arqos-sdio0 = [05];
				awqos-sdio0 = [05];
				arqos-sdio1 = [05];
				awqos-sdio1 = [05];
				arqos-sdio2 = [05];
				awqos-sdio2 = [05];
				arqos-emmc = [05];
				awqos-emmc = [05];
				phandle = <0xda>;
			};

			qos@2 {
				reg = <0x02>;
				arqos-threshold-main = [05];
				awqos-threshold-main = [05];
				arqos-threshold-merge = [06];
				awqos-threshold-merge = [06];
				phandle = <0xdb>;
			};
		};

		wcn {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qos@0 {
				reg = <0x00>;
				arqos-wifi = [0c];
				awqos-wifi = [0c];
				arqos-btwifi-i = [09];
				awqos-btwifi-i = [09];
				arqos-btwifi-d = [09];
				awqos-btwifi-d = [09];
				arqos-dma = [09];
				awqos-dma = [09];
				phandle = <0xdc>;
			};

			qos@1 {
				reg = <0x01>;
				arqos-gnss = [0c];
				awqos-gnss = [0c];
				arqos-gnss-i = [09];
				awqos-gnss-i = [09];
				arqos-gnss-d = [09];
				awqos-gnss-d = [09];
				arqos-dbuf = [09];
				awqos-dbuf = [09];
				phandle = <0xdd>;
			};

			qos@2 {
				reg = <0x02>;
				arqos-threshold-wcn = [09];
				awqos-threshold-wcn = [09];
				phandle = <0xde>;
			};
		};
	};

	aliases {
		i2c0 = "/soc/ap-apb/i2c@0x200d0000";
		i2c1 = "/soc/ap-apb/i2c@0x200e0000";
		i2c2 = "/soc/ap-apb/i2c@0x200f0000";
		i2c3 = "/soc/ap-apb/i2c@0x20100000";
		i2c4 = "/soc/ap-apb/i2c@0x20110000";
		i2c5 = "/soc/ap-apb/i2c@0x20210000";
		i2c6 = "/soc/ap-apb/i2c@0x20220000";
		i2c7 = "/soc/aon/i2c@641A0000";
		spi0 = "/soc/ap-apb/spi@20120000";
		spi1 = "/soc/ap-apb/spi@20130000";
		spi2 = "/soc/ap-apb/spi@20140000";
		spi3 = "/soc/ap-apb/spi@20150000";
		spi4 = "/soc/aon/spi@64200000";
		cooling-device0 = "/cooling-devices/cluster0-cooling";
		cooling-device1 = "/cooling-devices/cluster1-cooling";
		gpu-cooling0 = "/gpu-cooling-devices/gpu-cooling0";
		thm-sensor0 = "/virtual-sensor@0";
		v2-modem0 = "/modem@0";
		v2-modem1 = "/modem@1";
		seth0 = "/sipc-virt/core@5/channel@7";
		seth1 = "/sipc-virt/core@5/channel@8";
		seth2 = "/sipc-virt/core@5/channel@9";
		seth3 = "/sipc-virt/core@5/channel@18";
		seth4 = "/sipc-virt/core@5/channel@19";
		seth5 = "/sipc-virt/core@5/channel@20";
		seth6 = "/sipc-virt/core@5/channel@24";
		seth7 = "/sipc-virt/core@5/channel@25";
		seth8 = "/sipc-virt/core@5/channel@26";
		seth9 = "/sipc-virt/core@5/channel@27";
		seth10 = "/sipc-virt/core@5/channel@28";
		seth11 = "/sipc-virt/core@5/channel@29";
		seth12 = "/sipc-virt/core@5/channel@30";
		seth13 = "/sipc-virt/core@5/channel@31";
		serial0 = "/soc/ap-apb/serial@0x200a0000";
		serial1 = "/soc/ap-apb/serial@0x200b0000";
		serial2 = "/soc/ap-apb/serial@0x200c0000";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xdf>;

		syscon@20000000 {
			compatible = "sprd,ums9230-glbregs", "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x20000000 0x00 0x3000>;
			phandle = <0x05>;
		};

		ap-apb {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			serial@0x200a0000 {
				compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
				reg = <0x00 0x200a0000 0x00 0x100>;
				interrupts = <0x00 0x02 0x04>;
				source-base = <0x20010024>;
				clock-names = "enable", "uart", "source";
				clocks = <0x02 0x0e 0x03 0x01 0x04>;
				status = "okay";
				phandle = <0xe0>;
			};

			serial@0x200b0000 {
				compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
				reg = <0x00 0x200b0000 0x00 0x100>;
				interrupts = <0x00 0x03 0x04>;
				source-base = <0x20010028>;
				clock-names = "enable", "uart", "source";
				clocks = <0x02 0x0f 0x03 0x02 0x04>;
				status = "okay";
				phandle = <0xe1>;
			};

			serial@0x200c0000 {
				compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
				reg = <0x00 0x200c0000 0x00 0x100>;
				interrupts = <0x00 0x04 0x04>;
				source-base = <0x2001002c>;
				clock-names = "enable", "uart", "source";
				clocks = <0x02 0x10 0x03 0x03 0x04>;
				status = "okay";
				phandle = <0xe2>;
			};

			i2c@0x200d0000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x200d0000 0x00 0x100>;
				interrupts = <0x00 0x0b 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				reset-names = "i2c_rst";
				resets = <0x02 0x08>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x02 0x09 0x03 0x04 0x04>;
				phandle = <0xe3>;
			};

			i2c@0x200e0000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x200e0000 0x00 0x100>;
				interrupts = <0x00 0x0c 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				reset-names = "i2c_rst";
				resets = <0x02 0x09>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x02 0x0a 0x03 0x05 0x04>;
				phandle = <0xe4>;
			};

			i2c@0x200f0000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x200f0000 0x00 0x100>;
				interrupts = <0x00 0x0d 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				reset-names = "i2c_rst";
				resets = <0x02 0x0a>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x02 0x0b 0x03 0x06 0x04>;
				phandle = <0xe5>;
			};

			i2c@0x20100000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x20100000 0x00 0x100>;
				interrupts = <0x00 0x0e 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				reset-names = "i2c_rst";
				resets = <0x02 0x0b>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x02 0x0c 0x03 0x07 0x04>;
				phandle = <0xe6>;
			};

			i2c@0x20110000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x20110000 0x00 0x100>;
				interrupts = <0x00 0x0f 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				reset-names = "i2c_rst";
				resets = <0x02 0x0c>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x02 0x0d 0x03 0x08 0x04>;
				phandle = <0xe7>;
			};

			i2s@0x20160000 {
				compatible = "sprd,i2s";
				reg = <0x00 0x20160000 0x00 0x1000>;
				sprd,dai_name = "i2s_bt_sco0";
				sprd,hw_port = <0x00>;
				sprd,syscon-ap-apb = <0x05>;
				#sound-dai-cells = <0x00>;
				status = "okay";
				clock-names = "clk_iis0";
				clocks = <0x03 0x0f>;
				sprd,config_type = "pcm";
				sprd,slave_timeout = <0xf11>;
				sprd,fs = <0x1f40>;
				sprd,bus_type = <0x01>;
				sprd,rtx_mode = <0x03>;
				sprd,byte_per_chan = <0x01>;
				sprd,slave_mode = <0x00>;
				sprd,lsb = <0x00>;
				sprd,lrck = <0x00>;
				sprd,low_for_left = <0x01>;
				sprd,clk_inv = <0x00>;
				sprd,pcm_short_frame = <0x01>;
				sprd,pcm_slot = <0x01>;
				sprd,pcm_cycle = <0x01>;
				sprd,tx_watermark = <0x0c>;
				sprd,rx_watermark = <0x14>;
				phandle = <0xbd>;
			};

			i2c@0x20210000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x20210000 0x00 0x100>;
				interrupts = <0x00 0x23 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				reset-names = "i2c_rst";
				resets = <0x02 0x1a>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x02 0x1a 0x03 0x09 0x04>;
				phandle = <0xe8>;
			};

			i2c@0x20220000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x20220000 0x00 0x100>;
				interrupts = <0x00 0x24 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				reset-names = "i2c_rst";
				resets = <0x02 0x1b>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x02 0x1b 0x03 0x0a 0x04>;
				phandle = <0xe9>;
			};

			spi@20120000 {
				compatible = "sprd,sc9860-spi", "sprd,sharkl5-spi";
				reg = <0x00 0x20120000 0x00 0x1000>;
				interrupts = <0x00 0x05 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				clock-names = "enable", "spi", "source";
				clocks = <0x02 0x05 0x03 0x0b 0x06 0x03>;
				phandle = <0xea>;
			};

			spi@20130000 {
				compatible = "sprd,sc9860-spi", "sprd,sharkl5-spi";
				reg = <0x00 0x20130000 0x00 0x1000>;
				interrupts = <0x00 0x06 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <0x02 0x06 0x03 0x0c 0x06 0x03>;
				phandle = <0xeb>;
			};

			spi@20140000 {
				compatible = "sprd,sc9860-spi", "sprd,sharkl5-spi";
				reg = <0x00 0x20140000 0x00 0x1000>;
				interrupts = <0x00 0x07 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <0x02 0x07 0x03 0x0d 0x06 0x03>;
				phandle = <0xec>;
			};

			spi@20150000 {
				compatible = "sprd,sc9860-spi", "sprd,sharkl5-spi";
				reg = <0x00 0x20150000 0x00 0x1000>;
				interrupts = <0x00 0x08 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <0x02 0x08 0x03 0x0e 0x06 0x03>;
				phandle = <0xed>;
			};

			sdio@201d0000 {
				compatible = "sprd,sdhci-r11";
				reg = <0x00 0x201d0000 0x00 0x1000>;
				interrupts = <0x00 0x0a 0x04>;
				clock-names = "sdio", "enable";
				clocks = <0x03 0x16 0x02 0x19>;
				assigned-clocks = <0x03 0x16>;
				assigned-clock-parents = <0x07 0x00>;
				status = "okay";
				sprd,phy-delay-mmc-hs400es = <0x40 0x80 0x3d 0x3d>;
				sprd,phy-delay-mmc-hs400 = <0x3f 0xb5 0x3d 0x3d>;
				sprd,phy-delay-mmc-hs200 = <0x7f 0xb5 0xb5 0xb5>;
				sprd,phy-delay-mmc-ddr52 = <0x3e 0x6a 0x48 0x48>;
				sprd,phy-delay-mmc-highspeed = <0x60 0x2e 0x2c 0x2c>;
				vmmc-supply = <0x08>;
				voltage-ranges = <0xbb8 0xbb8>;
				bus-width = <0x08>;
				non-removable;
				cap-mmc-hw-reset;
				mmc-hs400-enhanced-strobe;
				mmc-hs400-1_8v;
				mmc-hs200-1_8v;
				mmc-ddr-1_8v;
				sprd,name = "sdio_emmc";
				sprd,sdio-adma;
				no-sdio;
				no-sd;
				phandle = <0xee>;
			};

			sdio@201a0000 {
				compatible = "sprd,sdhci-r11";
				reg = <0x00 0x201a0000 0x00 0x1000>;
				interrupts = <0x00 0x13 0x04>;
				sd-detect-pol-syscon = <0x09 0x444 0x04>;
				sd-hotplug-protect-en-syscon = <0x09 0x444 0x08>;
				sd-hotplug-debounce-en-syscon = <0x09 0x444 0x80>;
				sd-hotplug-debounce-cn-syscon = <0x09 0x444 0xff0000>;
				clock-names = "sdio", "enable";
				clocks = <0x03 0x14 0x02 0x16>;
				assigned-clocks = <0x03 0x14>;
				assigned-clock-parents = <0x07 0x00>;
				status = "okay";
				sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x73 0x72 0x72>;
				sprd,phy-delay-sd-uhs-sdr50 = <0x6e 0x7f 0x01 0x01>;
				sprd,phy-delay-sd-highspeed = <0x7f 0x1a 0x9a 0x9a>;
				sprd,phy-delay-legacy = <0x7f 0x1a 0x9a 0x9a>;
				vmmc-supply = <0x0a>;
				vqmmc-supply = <0x0b>;
				voltage-ranges = <0xbb8 0xbb8>;
				bus-width = <0x04>;
				sd-uhs-sdr104;
				sd-uhs-sdr50;
				sprd,name = "sdio_sd";
				sprd,sdio-adma;
				no-sdio;
				no-mmc;
				phandle = <0xef>;
			};

			sdio@201b0000 {
				compatible = "sprd,sdhci-r11";
				reg = <0x00 0x201b0000 0x00 0x1000>;
				interrupts = <0x00 0x14 0x04>;
				clock-names = "sdio", "enable";
				clocks = <0x03 0x15 0x02 0x17>;
				assigned-clocks = <0x03 0x15>;
				assigned-clock-parents = <0x06 0x17>;
				status = "disabled";
				phandle = <0xf0>;
			};

			apsys-dvfs@71700000 {
				compatible = "sprd,hwdvfs-apsys-qogirl6";
				reg = <0x00 0x20014000 0x00 0x15c>;
				sprd,ap-dvfs-up-window = <0x40>;
				sprd,ap-dvfs-down-window = <0x80>;
				phandle = <0xf1>;
			};

			rng@201e0000 {
				compatible = "sprd,sprd-trng";
				reg = <0x00 0x201e0000 0x00 0x10000>;
				clock-names = "ce-pub-eb", "ap-ce-clk", "source";
				clocks = <0x02 0x1e 0x03 0x13 0x06 0x09>;
				phandle = <0xf2>;
			};

			ufs@20200000 {
				compatible = "sprd,ufshc";
				vcc-supply = <0x08>;
				vcc-fixed-regulator;
				clock-names = "ufs_reg_eb", "ufs_en", "ufs_pclk", "ufs_pclk_source", "ufs_hclk", "ufs_hclk_source";
				clocks = <0x02 0x20 0x02 0x1f 0x03 0x1b 0x06 0x09 0x03 0x17 0x06 0x09>;
				reset-names = "ufs_rst", "ufs_glb_rst";
				resets = <0x02 0x18 0x02 0x1e>;
				freq-table-hz = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				reg = <0x00 0x20200000 0x00 0x10000 0x00 0x20400000 0x00 0x10000 0x00 0x64000000 0x00 0x100 0x00 0x64560000 0x00 0x10000>;
				reg-names = "ufshci_reg", "ap_ahb_reg", "aon_apb_reg", "ufs_analog_reg";
				aon_apb_ufs_en = <0x09 0x04 0x1800>;
				ap_ahb_ufs_clk = <0x0c 0x3124 0x40>;
				ap_apb_ufs_en = <0x05 0x0c 0x01>;
				ufs_refclk_on = <0x0c 0x311c 0x01>;
				ahb_ufs_lp = <0x0c 0x3104 0x37000000>;
				ahb_ufs_force_isol = <0x0c 0x3104 0x8000000>;
				ahb_ufs_lp_1 = <0x0c 0x3104 0x42000000>;
				ahb_ufs_cb = <0x0c 0x311c 0x06>;
				ahb_ufs_ies_en = <0x0c 0x3108 0x01>;
				ahb_ufs_cg_pclkreq = <0x0c 0x3124 0x01>;
				interrupts = <0x00 0x93 0x04>;
				status = "okay";
				phandle = <0xf3>;
			};
		};

		syscon@20400000 {
			compatible = "sprd,ums9230-glbregs", "syscon";
