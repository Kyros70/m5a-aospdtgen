	modem@0 {
		compatible = "unisoc,modem";
		syscon0 = <0x09 0xff 0x00>;
		syscon1 = <0x0d 0xff 0x00>;
		syscon2 = <0x09 0x8c 0x01>;
		syscon3 = <0x09 0xff 0x00>;
		syscon4 = <0x09 0xff 0x00>;
		syscon-names = "shutdown", "deepsleep", "corereset", "sysreset", "getstatus";
		sprd,version = <0x02>;
		phandle = <0x19f>;
	};

	modem@1 {
		compatible = "unisoc,modem";
		sprd,decoup = "cproc-use-decoup";
		syscon0 = <0x0d 0x330 0x2000000>;
		syscon1 = <0x0d 0x818 0x02>;
		syscon2 = <0x09 0x174 0x400>;
		syscon3 = <0x0d 0xb98 0x800>;
		syscon4 = <0x09 0xff 0x00>;
		syscon5 = <0x0d 0xb88 0x18>;
		syscon-names = "shutdown", "deepsleep", "corereset", "sysreset", "getstatus", "dspreset";
		sprd,version = <0x02>;
		phandle = <0x1a0>;
	};

	cp_dump {
		compatible = "sprd,cp_dump";
		sprd,sys-bus-ctrl-sp = <0x09 0x124 0x01>;
	};

	pubcp_dvfs {
		compatible = "sprd,pubcp-dvfs";
		sprd,core_id = <0x00>;
		sprd,devices-num = <0x01>;
		sprd,devices-name = "core_axi";
		sprd,devices-id = <0x00>;
